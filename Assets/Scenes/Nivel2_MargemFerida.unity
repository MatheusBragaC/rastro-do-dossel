  falas:
  - inicio: 0.3
    fim: 4.4
    texto: "RASTRO DO DOSSEL\n<size=40>N\xEDvel 2 \u2014 Margem ferida</size>"
    titulo: 1
  - inicio: 1.2
    fim: 5.2
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> O rio est\xE1 perto. Tem uma
      esta\xE7\xE3o de \xE1gua parada na margem."
    titulo: 0
  - inicio: 5.3
    fim: 8.6
    texto: <color=#9FE0FF>MARA:</color> Se ela voltar a funcionar, o pessoal da travessia
      agradece.
    titulo: 0
  - inicio: 8.7
    fim: 12.2
    texto: "<color=#FFC46B>NILO:</color> As pedras do rio ainda est\xE3o l\xE1. Vou
      atravessar."
    titulo: 0

  - inicio: 5.3
    fim: 8.4
    texto: <color=#9FE0FF>MARA:</color> Eu acompanho enquanto houver sinal.
    titulo: 0
  - inicio: 8.5
    fim: 12.6
    texto: "<color=#FFC46B>NILO:</color> Conhe\xE7o o come\xE7o da trilha. Vou avisando."

    texto: "RASTRO DO DOSSEL\n<size=40>N\xEDvel 1 \u2014 Trilha encoberta</size>"
    titulo: 1
  - inicio: 1.2
    fim: 5.2
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> A travessia fecha ao amanhecer.

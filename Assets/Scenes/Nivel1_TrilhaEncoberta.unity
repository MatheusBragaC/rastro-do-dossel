  falas:
  - inicio: 0.3
    fim: 4.4
    texto: "RASTRO DO DOSSEL\n<size=40>N\xEDvel 1 \u2014 Trilha encoberta</size>"
    titulo: 1
  - inicio: 1.2
    fim: 2.9
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> Sabi\xE1... tem gente da Vig\xEDlia
      no repetidor!"
    titulo: 0
  - inicio: 3
    fim: 5.2
    texto: "<color=#9FE0FF>MARA:</color> Derrubaram! Sem o repetidor, o vale n\xE3o
      escuta a gente."
    titulo: 0
  - inicio: 5.3
    fim: 8.4
    texto: "<color=#9FE0FF>MARA:</color> S\xF3 resta a antena da serra. Leve o m\xF3dulo
      at\xE9 l\xE1 antes do amanhecer."
    titulo: 0
  - inicio: 8.5
    fim: 12.6
    texto: "<color=#FFC46B>NILO:</color> Conhe\xE7o o come\xE7o da trilha. Vou avisando."
    titulo: 0
  retornoDuracao: 1.2
  neblinaFim: 0
  ancora: {fileID: 0}
  ancoraOrigem: {x: 0, y: 0, z: 0}

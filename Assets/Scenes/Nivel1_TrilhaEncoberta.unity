  falas:
  - inicio: 0.3
    fim: 3.4
    texto: "<color=#FFC46B>NILO:</color> Posto da Vig\xEDlia livre. Mara, est\xE1
      me ouvindo?"
    titulo: 0
  - inicio: 3.5
    fim: 7
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> Ouvi, Sabi\xE1. O sinal passou
      pelo posto."
    titulo: 0
  - inicio: 7.1
    fim: 11.4
    texto: "<color=#9FE0FF>MARA:</color> A antena est\xE1 na serra. Siga pela margem
      do rio antes do amanhecer."
    titulo: 0
  - inicio: 8.8
    fim: 11.7
    texto: "FIM DO N\xCDVEL 1"
    titulo: 1

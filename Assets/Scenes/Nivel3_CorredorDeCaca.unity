  id: Final_N3
  tocarAoIniciar: 0
  tomadas:
  - posicao: {x: 57, y: 1.9, z: 102.2}
    olharPara: {x: 59.8, y: 1.2, z: 100}
    duracao: 0.5
  - posicao: {x: 58.5, y: 4.2, z: 97}
    olharPara: {x: 80, y: 6, z: 122}

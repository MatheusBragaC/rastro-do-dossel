  falas:
  - inicio: 0.3
    fim: 3.8
    texto: "<color=#FFC46B>NILO:</color> Mara... fui eu quem mostrou essas trilhas
      \xE0 Vig\xEDlia."
    titulo: 0
  - inicio: 3.9
    fim: 7.6
    texto: "<color=#FFC46B>NILO:</color> A passagem antiga fica acima do corredor.
      D\xE1 para ver daqui: as marcas laranja."
    titulo: 0
  - inicio: 7.7
    fim: 10.8
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> Ent\xE3o me diga cada refer\xEAncia.
      Vamos orientar os outros."
    titulo: 0
  - inicio: 10.9
    fim: 12.5
    texto: "<color=#FFC46B>NILO:</color> Pedra grande, marca laranja, depois o posto
      das ra\xEDzes."
    titulo: 0
  - inicio: 11.4
    fim: 12.5
    texto: "FIM DO N\xCDVEL 3"
    titulo: 1

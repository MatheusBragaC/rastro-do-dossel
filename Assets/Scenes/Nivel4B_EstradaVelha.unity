  falas:
  - inicio: 0.3
    fim: 4.2
    texto: "RASTRO DO DOSSEL\n<size=40>N\xEDvel 4B \u2014 A estrada velha</size>"
    titulo: 1
  - inicio: 1
    fim: 4
    texto: <color=#C8F08C>IVO:</color> Ela pega no tranco, mas pega. Foi do meu pai.
    titulo: 0
  - inicio: 4.1
    fim: 7.2
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> Sabi\xE1, tem um jipe da Vig\xEDlia
      descendo atr\xE1s de voc\xEA!"
    titulo: 0
  - inicio: 7.3
    fim: 9.4
    texto: "<color=#C8F08C>IVO:</color> VAI! A estrada velha desce at\xE9 o p\xE9
      da serra!"
    titulo: 0
  - inicio: 9.5
    fim: 11.4
    texto: <color=#FFC46B>NILO:</color> Segura firme, Ivo.
    titulo: 0

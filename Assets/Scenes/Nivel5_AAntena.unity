  - posicao: {x: 0, y: 3.2, z: 100}
    olharPara: {x: 12, y: 1.2, z: 108}
    duracao: 3
  falas:
  - inicio: 0.3
    fim: 2.6
    texto: "<color=#FFC46B>NILO:</color> Entrada fechada. O solo protegido fica fora
      do caminho das m\xE1quinas."
    titulo: 0
  - inicio: 2.7
    fim: 5
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> Outra sentinela! Ela guarda o
      port\xE3o da antena."
    titulo: 0
  - inicio: 5.1
    fim: 7.2
    texto: "<color=#9FE0FF>MARA:</color> Mesmo jeito da primeira: desvie do avan\xE7o
      e do bra\xE7o."
    titulo: 0
  - inicio: 7.3
    fim: 10.2
    texto: "<color=#9FE0FF>MARA:</color> Quando ela bater e travar, tire as tr\xEAs
      baterias com E."
    titulo: 0
  retornoDuracao: 1.2
  neblinaFim: 0

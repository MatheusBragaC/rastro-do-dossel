    duracao: 4.2
  falas:
  - inicio: 0.3
    fim: 4.2
    texto: "<color=#FFC46B>NILO:</color> V\xE1rzea Alta, n\xE3o cruzem pelo rio.
      Sigam as marcas novas na encosta e passem pelo posto."
    titulo: 0
  - inicio: 4.3
    fim: 7.4
    texto: "<color=#9FE0FF>MARA (r\xE1dio):</color> Recebido, Sabi\xE1. Vamos avisar
      os outros."
    titulo: 0
  - inicio: 7.5
    fim: 10.6
    texto: "<color=#B8B8B8>V\xC1RZEA ALTA (r\xE1dio):</color> Recebido. Esperamos
      o dia e seguimos as marcas."
    titulo: 0
  - inicio: 10.7
    fim: 13.6
    texto: "<color=#C8F08C>IVO (r\xE1dio):</color> O posto das ra\xEDzes est\xE1
      aberto. Tem lugar para todo mundo."
    titulo: 0
  - inicio: 13.7
    fim: 17.1
    texto: "FIM\n<size=38>O assobio do Sabi\xE1 agora marca um caminho que todos
      conhecem.</size>"
    titulo: 1
  retornoDuracao: 1.2
  neblinaFim: 220

  tocarAoIniciar: 0
  tomadas:
  - posicao: {x: -1, y: 2, z: 101.5}
    olharPara: {x: 14, y: 1.4, z: 110}
    duracao: 0.6
  - posicao: {x: 7, y: 1.6, z: 103}
    olharPara: {x: 14, y: 1.6, z: 110}
    duracao: 3.2
  - posicao: {x: 10, y: 6, z: 116}
